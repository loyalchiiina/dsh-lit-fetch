{
  "name": "dsh-lit-fetch",
  "version": "1.0.5",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg",
    "README-zh.md",
    "README-es.md",
    "README-pt.md",
    "README-hi.md"
  ],
  "license": "MIT",
  "description": "学术文献检索与 PDF 下载 / Academic literature search & PDF download — 按 DOI（Crossref）或关键词（OpenAlex）检索文献元数据，遍历 8 个 Sci-Hub 镜像下载 PDF 并以 Unpaywall 开放获取兜底，校验 %PDF- 魔数与最小体积，生成可点击的批量获取清单 HTML。不是网页正文抓取工具。 · Looks up papers by DOI (Crossref) or keyword (OpenAlex), downloads PDFs through 8 Sci-Hub mirrors with an Unpaywall open-access fallback, validates %PDF- magic bytes and minimum size, and emits a clickable batch-access HTML manifest. Not a web-page text extractor.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "literature",
    "scihub",
    "doi",
    "pdf-download",
    "academic"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loyalchiiina/dsh-lit-fetch.git"
  },
  "homepage": "https://github.com/loyalchiiina/dsh-lit-fetch#readme",
  "bugs": {
    "url": "https://github.com/loyalchiiina/dsh-lit-fetch/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.1 || ^0.2.0-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.1 || ^0.2.0-rc.1"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0"
}
