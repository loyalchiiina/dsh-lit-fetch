{
  "name": "dsh-lit-fetch",
  "version": "1.0.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": ["lib/**/*.js", "cordis.patch.yml", "README.md", "LICENSE"],
  "license": "MIT",
  "description": "DSH literature fetcher: search academic papers via DOI, download PDFs through Sci-Hub mirrors and Open Access fallback, generate batch access HTML manifests.",
